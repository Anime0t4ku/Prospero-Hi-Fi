# Optional Linux build for UI/protocol regression work (no real optical backend).
CXX ?= c++
BUILD := build-host/preview
CPPFLAGS += -DSDL_MAIN_HANDLED -Iinclude -Ithird_party -Ithird_party/libsmb2/include $(HOST_EXTRA_CFLAGS)
CXXFLAGS += -std=c++17 -O1 -pthread
SOURCES := $(wildcard source/*.cpp)
OBJECTS := $(patsubst source/%.cpp,$(BUILD)/%.o,$(SOURCES))
HOST_SMB_LIB ?= -lsmb2
HOST_EXTRA_LIBS ?= -lSDL2 -lSDL2_image -lSDL2_ttf -lpng -ljpeg -lcurl
all: build-host/prospero-preview
$(BUILD)/%.o: source/%.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
build-host/prospero-preview: $(OBJECTS) build-host/decoder.o build-host/cover_codec.o
	$(CXX) -pthread $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -o $@
-include $(OBJECTS:.o=.d)

# Exercise the real application input/draw path with SDL dummy output.
$(BUILD)/app_player_test.o: tests/app_player_test.cpp source/main.cpp $(wildcard include/*.hpp include/*.inc)
	@mkdir -p $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
build-host/prospero-player-test: $(BUILD)/app_player_test.o $(filter-out $(BUILD)/main.o,$(OBJECTS)) build-host/decoder.o build-host/cover_codec.o
	$(CXX) -pthread $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -o $@
.PHONY: test-player
test-player: build-host/prospero-player-test
	./build-host/prospero-player-test

# Decoder/cover objects are built from source in a fresh checkout.
build-host/decoder.o: source/decoder.c $(wildcard include/*.h include/*.hpp)
	@mkdir -p build-host
	$(CC) $(CPPFLAGS) -O1 -c $< -o $@
build-host/cover_codec.o: source/cover_codec.c $(wildcard include/*.h)
	@mkdir -p build-host
	$(CC) $(CPPFLAGS) -O1 -c $< -o $@
